{
  "Verbose": false,
  "Debug": false,
  "IgnoreDefaults": false,
  "SpacesAfterTabs": false,
  "NoColor": true,
  "Exclude": [
    "^LICENSES/",
    "^LICENSE$",
    "\\.git/",
    "node_modules/",
    "target/",
    "_build/",
    "deps/",
    "\\.deno/",
    "external_corpora/",
    "\\.lake/"
  ],
  "Disable": {
    "Indentation": [
      "Justfile",
      "^\\.github/workflows/",
      "^\\.github/GOVERNANCE\\.md$",
      "^\\.github/SECURITY\\.md$",
      "^\\.github/scripts/classify-issue\\.jq$",
      "^\\.githooks/validate-k9\\.sh$",
      "^\\.machine_readable/contractiles/",
      "^\\.machine_readable/scripts/maintenance/maint-assault\\.sh$",
      "^CLAUDE\\.md$",
      "^EXPLAINME\\.adoc$",
      "^build/guix\\.scm$",
      "^build/\\.guix-channel$",
      "^docs/",
      "^verification/proofs/"
    ]
  }
}
